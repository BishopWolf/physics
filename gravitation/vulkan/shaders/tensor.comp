#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// Tensor contractions for general relativity on the GPU, in double precision.
//
// For every lattice point this shader computes, from a metric given as an
// analytic function of the coordinates:
//   g_ab, d_mu g_ab (central differences), Gamma^k_ij, d_mu Gamma^k_ij,
//   R^rho_{sigma mu nu}, Ric_ij = R^k_{i k j}, R = g^{ij} Ric_ij,
//   G_ij = Ric_ij - 1/2 R g_ij, and the Kretschmann scalar
//   K = R_{rho sigma mu nu} R^{rho sigma mu nu}.
//
// Everything is kept in `double`: the derivatives are difference quotients, so
// single precision would put the noise floor of `K` at the percent level.
//
// Output layout, 50 doubles per point:
//   [ 0..15] g_ab     (row major, a*4+b)
//   [16..31] Ric_ab
//   [   32] R
//   [33..48] G_ab
//   [   49] Kretschmann K
//
// Index conventions: g[16*a+b] = g_ab, G[16*k+4*i+j] = Gamma^k_ij,
// dG[64*mu+16*k+4*i+j] = d_mu Gamma^k_ij, Rup[64*rho+16*sigma+4*mu+nu] =
// R^rho_{sigma mu nu}.

layout(local_size_x = 64) in;

layout(push_constant) uniform Params {
    int   metricId;   // 0 Minkowski, 1 Schwarzschild, 2 Schwarzschild-de Sitter
    float massM;
    float lambdaC;
    float h;          // finite-difference step
    vec4  lo;         // lower corner in (t, r, theta, phi)
    vec4  stepv;      // lattice step per coordinate
    ivec4 grid;       // lattice size per coordinate
} P;

layout(std430, binding = 0) writeonly buffer Out {
    double data[];
};

const int STRIDE = 50;

void metricAt(int id, double mm, double lc, dvec4 x, out double g[16])
{
    for (int i = 0; i < 16; ++i) g[i] = 0.0;

    if (id == 0) {
        // Minkowski, signature (-,+,+,+)
        g[0] = -1.0;
        g[5] = 1.0;
        g[10] = 1.0;
        g[15] = 1.0;
    } else {
        double r  = x.y;
        double th = x.z;
        double f  = 1.0 - 2.0 * mm / r;
        if (id == 2) {
            // Schwarzschild-de Sitter: Ric = Lambda * g
            f -= (lc / 3.0) * r * r;
        }
        g[0]  = -f;
        g[5]  = 1.0 / f;
        g[10] = r * r;
        // GLSL has no double-precision `sin`.  Each lattice line fixes theta to
        // theta0 + delta with tiny |delta|, so expand around float sin/cos at
        // theta0: the metric then stays a smooth function of theta, which is what
        // the difference quotients differentiate.
        double sz = double(P.stepv.z);
        double t0 = double(P.lo.z)
                  + (sz != 0.0 ? round((th - double(P.lo.z)) / sz) : 0.0) * sz;
        double d  = th - t0;
        double s0 = double(sin(float(t0)));
        double c0 = double(cos(float(t0)));
        double sth = s0 + c0 * d - 0.5 * s0 * d * d - c0 * d * d * d / 6.0;
        g[15] = r * r * sth * sth;
    }
}

double det3(double a00, double a01, double a02,
            double a10, double a11, double a12,
            double a20, double a21, double a22)
{
    return a00 * (a11 * a22 - a12 * a21)
         - a01 * (a10 * a22 - a12 * a20)
         + a02 * (a10 * a21 - a11 * a20);
}

void inv4(in double a[16], out double inv[16], out double det)
{
    double c[16];
    c[0]  =  det3(a[5], a[6], a[7],  a[9], a[10], a[11],  a[13], a[14], a[15]);
    c[1]  = -det3(a[4], a[6], a[7],  a[8], a[10], a[11],  a[12], a[14], a[15]);
    c[2]  =  det3(a[4], a[5], a[7],  a[8], a[9],  a[11],  a[12], a[13], a[15]);
    c[3]  = -det3(a[4], a[5], a[6],  a[8], a[9],  a[10],  a[12], a[13], a[14]);
    c[4]  = -det3(a[1], a[2], a[3],  a[9], a[10], a[11],  a[13], a[14], a[15]);
    c[5]  =  det3(a[0], a[2], a[3],  a[8], a[10], a[11],  a[12], a[14], a[15]);
    c[6]  = -det3(a[0], a[1], a[3],  a[8], a[9],  a[11],  a[12], a[13], a[15]);
    c[7]  =  det3(a[0], a[1], a[2],  a[8], a[9],  a[10],  a[12], a[13], a[14]);
    c[8]  =  det3(a[1], a[2], a[3],  a[5], a[6],  a[7],   a[13], a[14], a[15]);
    c[9]  = -det3(a[0], a[2], a[3],  a[4], a[6],  a[7],   a[12], a[14], a[15]);
    c[10] =  det3(a[0], a[1], a[3],  a[4], a[5],  a[7],   a[12], a[13], a[15]);
    c[11] = -det3(a[0], a[1], a[2],  a[4], a[5],  a[6],   a[12], a[13], a[14]);
    c[12] = -det3(a[1], a[2], a[3],  a[5], a[6],  a[7],   a[9],  a[10], a[11]);
    c[13] =  det3(a[0], a[2], a[3],  a[4], a[6],  a[7],   a[8],  a[10], a[11]);
    c[14] = -det3(a[0], a[1], a[3],  a[4], a[5],  a[7],   a[8],  a[9],  a[11]);
    c[15] =  det3(a[0], a[1], a[2],  a[4], a[5],  a[6],   a[8],  a[9],  a[10]);

    det = a[0] * c[0] + a[1] * c[1] + a[2] * c[2] + a[3] * c[3];

    for (int i = 0; i < 4; ++i)
        for (int j = 0; j < 4; ++j)
            inv[i * 4 + j] = c[j * 4 + i] / det;
}

void dMetric(int id, double mm, double lc, dvec4 x, double h, out double dg[64])
{
    for (int mu = 0; mu < 4; ++mu) {
        dvec4 xp = x;
        dvec4 xm = x;
        xp[mu] += h;
        xm[mu] -= h;
        double gp[16];
        double gm[16];
        metricAt(id, mm, lc, xp, gp);
        metricAt(id, mm, lc, xm, gm);
        for (int ab = 0; ab < 16; ++ab)
            dg[16 * mu + ab] = (gp[ab] - gm[ab]) / (2.0 * h);
    }
}

void christoffel(in double g[16], in double dg[64], out double G[64])
{
    double ginv[16];
    double det;
    inv4(g, ginv, det);

    for (int k = 0; k < 4; ++k)
    for (int i = 0; i < 4; ++i)
    for (int j = 0; j < 4; ++j) {
        double s = 0.0;
        for (int l = 0; l < 4; ++l)
            s += ginv[k * 4 + l]
               * (dg[16 * i + j * 4 + l]
                + dg[16 * j + i * 4 + l]
                - dg[16 * l + i * 4 + j]);
        G[16 * k + 4 * i + j] = 0.5 * s;
    }
}

void main()
{
    uint tid = gl_GlobalInvocationID.x;
    uint total = uint(P.grid.x) * uint(P.grid.y) * uint(P.grid.z) * uint(P.grid.w);
    if (tid >= total) return;

    int i0 = int(tid % uint(P.grid.x));
    int i1 = int((tid / uint(P.grid.x)) % uint(P.grid.y));
    int i2 = int((tid / (uint(P.grid.x) * uint(P.grid.y))) % uint(P.grid.z));
    int i3 = int((tid / (uint(P.grid.x) * uint(P.grid.y) * uint(P.grid.z))) % uint(P.grid.w));

    // The lattice is walked in double so the host and the shader agree on the
    // sampled radii to full precision.
    dvec4 x = dvec4(P.lo) + dvec4(float(i0), float(i1), float(i2), float(i3)) * dvec4(P.stepv);

    double mm = double(P.massM);
    double lc = double(P.lambdaC);
    double h  = double(P.h);

    double g[16];
    metricAt(P.metricId, mm, lc, x, g);

    double dg[64];
    dMetric(P.metricId, mm, lc, x, h, dg);

    double G0[64];
    christoffel(g, dg, G0);

    // d_mu Gamma^k_ij by central differences of the Christoffel symbols.
    double dG[256];
    for (int mu = 0; mu < 4; ++mu) {
        dvec4 xp = x;
        dvec4 xm = x;
        xp[mu] += h;
        xm[mu] -= h;

        double gp[16], gm[16], dgp[64], dgm[64], Gp[64], Gm[64];
        metricAt(P.metricId, mm, lc, xp, gp);
        metricAt(P.metricId, mm, lc, xm, gm);
        dMetric(P.metricId, mm, lc, xp, h, dgp);
        dMetric(P.metricId, mm, lc, xm, h, dgm);
        christoffel(gp, dgp, Gp);
        christoffel(gm, dgm, Gm);

        for (int t = 0; t < 64; ++t)
            dG[64 * mu + t] = (Gp[t] - Gm[t]) / (2.0 * h);
    }

    // R^rho_{sigma mu nu} = d_mu G^rho_{nu sigma} - d_nu G^rho_{mu sigma}
    //                     + G^rho_{mu lambda} G^lambda_{nu sigma}
    //                     - G^rho_{nu lambda} G^lambda_{mu sigma}
    double Rup[256];
    for (int rho = 0; rho < 4; ++rho)
    for (int sig = 0; sig < 4; ++sig)
    for (int mu = 0; mu < 4; ++mu)
    for (int nu = 0; nu < 4; ++nu) {
        double s = dG[64 * mu + 16 * rho + 4 * nu + sig]
                 - dG[64 * nu  + 16 * rho + 4 * mu + sig];
        for (int lam = 0; lam < 4; ++lam)
            s += G0[16 * rho + 4 * mu + lam] * G0[16 * lam + 4 * nu + sig]
               - G0[16 * rho + 4 * nu  + lam] * G0[16 * lam + 4 * mu + sig];
        Rup[64 * rho + 16 * sig + 4 * mu + nu] = s;
    }

    // Ric_sigma_nu = R^rho_{sigma rho nu}
    double Ric[16];
    for (int i = 0; i < 16; ++i) Ric[i] = 0.0;
    for (int sig = 0; sig < 4; ++sig)
    for (int nu = 0; nu < 4; ++nu) {
        double s = 0.0;
        for (int rho = 0; rho < 4; ++rho)
            s += Rup[64 * rho + 16 * sig + 4 * rho + nu];
        Ric[4 * sig + nu] = s;
    }

    double ginv[16];
    double det;
    inv4(g, ginv, det);

    double R = 0.0;
    for (int a = 0; a < 4; ++a)
        for (int b = 0; b < 4; ++b)
            R += ginv[a * 4 + b] * Ric[a * 4 + b];

    // Riemann with all indices lowered: R_{rho sigma mu nu} = g_{rho lambda} R^lambda_{sigma mu nu}.
    double Rlo[256];
    for (int rho = 0; rho < 4; ++rho)
    for (int sig = 0; sig < 4; ++sig)
    for (int mu = 0; mu < 4; ++mu)
    for (int nu = 0; nu < 4; ++nu) {
        double s = 0.0;
        for (int lam = 0; lam < 4; ++lam)
            s += g[4 * rho + lam] * Rup[64 * lam + 16 * sig + 4 * mu + nu];
        Rlo[64 * rho + 16 * sig + 4 * mu + nu] = s;
    }

    // Kretschmann scalar K = R_{rho sigma mu nu} R^{rho sigma mu nu}: raise the
    // indices one pass at a time, then contract against the lowered tensor.
    double R1[256];
    for (int a = 0; a < 4; ++a)
    for (int b = 0; b < 4; ++b)
    for (int c = 0; c < 4; ++c)
    for (int d = 0; d < 4; ++d) {
        double s = 0.0;
        for (int l = 0; l < 4; ++l)
            s += ginv[4 * a + l] * Rlo[64 * l + 16 * b + 4 * c + d];
        R1[64 * a + 16 * b + 4 * c + d] = s;
    }
    double R2[256];
    for (int a = 0; a < 4; ++a)
    for (int b = 0; b < 4; ++b)
    for (int c = 0; c < 4; ++c)
    for (int d = 0; d < 4; ++d) {
        double s = 0.0;
        for (int l = 0; l < 4; ++l)
            s += ginv[4 * b + l] * R1[64 * a + 16 * l + 4 * c + d];
        R2[64 * a + 16 * b + 4 * c + d] = s;
    }
    double R3[256];
    for (int a = 0; a < 4; ++a)
    for (int b = 0; b < 4; ++b)
    for (int c = 0; c < 4; ++c)
    for (int d = 0; d < 4; ++d) {
        double s = 0.0;
        for (int l = 0; l < 4; ++l)
            s += ginv[4 * c + l] * R2[64 * a + 16 * b + 4 * l + d];
        R3[64 * a + 16 * b + 4 * c + d] = s;
    }
    double R4[256];
    for (int a = 0; a < 4; ++a)
    for (int b = 0; b < 4; ++b)
    for (int c = 0; c < 4; ++c)
    for (int d = 0; d < 4; ++d) {
        double s = 0.0;
        for (int l = 0; l < 4; ++l)
            s += ginv[4 * d + l] * R3[64 * a + 16 * b + 4 * c + l];
        R4[64 * a + 16 * b + 4 * c + d] = s;
    }
    double K = 0.0;
    for (int i = 0; i < 256; ++i) K += R4[i] * Rlo[i];

    uint base = tid * uint(STRIDE);
    for (int i = 0; i < 16; ++i) data[base + uint(i)] = g[i];
    for (int i = 0; i < 16; ++i) data[base + 16u + uint(i)] = Ric[i];
    data[base + 32u] = R;
    for (int i = 0; i < 16; ++i)
        data[base + 33u + uint(i)] = Ric[i] - 0.5 * R * g[i];
    data[base + 49u] = K;
}
